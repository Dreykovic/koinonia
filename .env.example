APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
# Canaux du stack, séparés par des virgules (prod : daily)
LOG_STACK=single
# Prod : Monolog\Formatter\JsonFormatter (laisser vide en local)
LOG_FORMATTER=
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Monitoring et alertes locales (config/monitoring.php, docs/logging.md)
# Interrupteur des e-mails d'alerte (la ligne de log critical reste ecrite)
ALERT_ENABLED=true
# Destinataires separes par des virgules ; vide = admins actifs de l'application
ALERT_MAIL_TO=
# Minutes minimales entre deux e-mails pour une meme regle
ALERT_THROTTLE_MINUTES=30
# Pic d'erreurs 5xx : N exceptions en X minutes
ALERT_ERROR_SPIKE_THRESHOLD=10
ALERT_ERROR_SPIKE_WINDOW=5
# Echecs d'envoi de mails : N echecs en X minutes
ALERT_MAIL_FAILURE_THRESHOLD=3
ALERT_MAIL_FAILURE_WINDOW=15
# Echecs de diffusion temps reel (broadcast) : N echecs en X minutes
ALERT_BROADCAST_FAILURE_THRESHOLD=5
ALERT_BROADCAST_FAILURE_WINDOW=10
# Alerte sur les jobs en echec
ALERT_QUEUE_FAILURE=true
# Seuils de lenteur (ms) pour les requetes SQL et HTTP
MONITORING_SLOW_QUERY_MS=500
MONITORING_SLOW_REQUEST_MS=2000
# Age max (minutes) du battement du scheduler avant alerte
MONITORING_HEARTBEAT_MAX_AGE=5

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production (https) : decommenter la ligne suivante
# SESSION_SECURE_COOKIE=true
# Derriere un proxy/CDN : TRUSTED_PROXIES=* (ou liste d'IP separees par des virgules)
TRUSTED_PROXIES=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Secondes avant d'abandonner un serveur SMTP qui ne repond pas
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"





